@model ReLiveWP.Services.Login.Models.Ppsecure.GetKeyDataModel
<?xml version="1.0" encoding="utf-8" ?>
<S:Envelope xmlns:S="http://www.w3.org/2003/05/soap-envelope"
            xmlns:ps="http://schemas.microsoft.com/Passport/SoapServices/PPCRL">
    <S:Body>
        <ps:GetKeyDataResponse>
            <ps:KeyPurposes>
                <ps:KeyPurpose name="@Model.Purpose">
                    <ps:KeyData>
                        <ps:Property name="KeyMaterial">@Model.KeyMaterial</ps:Property>
                        <ps:Property name="TimeStamp">@Model.TimeStamp</ps:Property>
                    </ps:KeyData>
                </ps:KeyPurpose>
            </ps:KeyPurposes>
        </ps:GetKeyDataResponse>
    </S:Body>
</S:Envelope>