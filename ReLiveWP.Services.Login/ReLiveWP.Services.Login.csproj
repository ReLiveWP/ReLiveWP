<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>6cc4b98e-30b7-4216-85cd-65ac619f665a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Razor.Templating.Core" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReLiveWP.Identity\ReLiveWP.Identity.csproj" />
    <ProjectReference Include="..\ReLiveWP.Passport\ReLiveWP.Passport.csproj" />
    <ProjectReference Include="..\ReLiveWP.ServiceDefaults\ReLiveWP.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../protos/authentication.proto" GrpcServices="Client">
      <Link>Protos\authentication.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/oauth.proto" GrpcServices="Client">
      <Link>Protos\oauth.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/user.proto" GrpcServices="Client">
      <Link>Protos\user.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/device_registration.proto" GrpcServices="Client">
      <Link>Protos\device_registration.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/client_provisioning.proto" GrpcServices="Client">
      <Link>Protos\client_provisioning.proto</Link>
    </Protobuf>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Utilities\" />
  </ItemGroup>

  <PropertyGroup>
    <LoginSpaDir>$(MSBuildProjectDirectory)\..\ReLiveWP.Web\relivewp.web.login</LoginSpaDir>
    <BuildLoginSpa Condition="'$(BuildLoginSpa)' == ''">false</BuildLoginSpa>
  </PropertyGroup>

  <Target Name="BuildLoginSpa" BeforeTargets="AssignTargetPaths" Condition="'$(BuildLoginSpa)' == 'true'">
    <Message Importance="high" Text="Building relivewp.web.login (IE11 bundle)..." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(LoginSpaDir)" />
    <Exec Command="pnpm run build" WorkingDirectory="$(LoginSpaDir)" />
    <ItemGroup>
      <LoginSpaAssets Include="$(LoginSpaDir)\dist\assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LoginSpaAssets)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\ppsecure\assets\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
