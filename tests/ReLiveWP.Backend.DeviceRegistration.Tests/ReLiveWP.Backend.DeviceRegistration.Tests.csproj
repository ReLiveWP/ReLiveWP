<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ReLiveWP.Backend.DeviceRegistration\ReLiveWP.Backend.DeviceRegistration.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ProductKeysProject>$(MSBuildThisFileDirectory)..\..\private\ReLiveWP.ProductKeys\ReLiveWP.ProductKeys.csproj</ProductKeysProject>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(ProductKeysProject)')">
    <DefineConstants>$(DefineConstants);PRODUCT_KEYS</DefineConstants>
  </PropertyGroup>

</Project>
