{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [ "ES2015", "DOM", "DOM.Iterable" ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [],
    "baseUrl": ".",
    "paths": { "~/*": [ "./src/*" ] }
  },
  "include": [ "src" ]
}
