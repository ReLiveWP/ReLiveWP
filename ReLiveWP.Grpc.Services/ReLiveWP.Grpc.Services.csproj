<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../protos/authentication.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\authentication.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/oauth.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\oauth.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/user.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\user.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/find_my_phone.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\find_my_phone.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/client_provisioning.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\client_provisioning.proto</Link>
    </Protobuf>
    <Protobuf Include="../protos/device_registration.proto" GrpcServices="Client" Access="Public">
      <Link>Protos\device_registration.proto</Link>
    </Protobuf>
  </ItemGroup>

</Project>
