# OpenSSL config for the Push service ONLY.
# WP7/WP8 devices negotiate the push-channel TLS handshake with legacy protocols and
# ciphers that Debian's default OpenSSL (SECLEVEL=2) rejects. Lowering to SECLEVEL=0 +
# MinProtocol=TLSv1 restores compatibility. Scoped to push via OPENSSL_CONF in compose so
# the rest of the stack keeps modern defaults.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT:@SECLEVEL=0
