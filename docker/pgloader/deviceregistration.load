-- Data-only copy of the legacy SQLite devices.db into the EF-created relive_deviceregistration schema.
LOAD DATABASE
     FROM     sqlite:///data/devices.db
     INTO     postgresql://relive:relive@postgres/relive_deviceregistration
 WITH data only, truncate, reset sequences, quote identifiers
  SET work_mem to '32MB'
EXCLUDING TABLE NAMES LIKE '__EFMigrations%';
