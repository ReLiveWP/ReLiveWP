{
  "name": "@relivewp/eas-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Turns an Exchange ActiveSync change stream into a mailbox",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@relivewp/eas-client": "workspace:*",
    "@relivewp/eas-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2"
  }
}
