{
  "name": "@relivewp/eas-store",
  "version": "0.0.0",
  "private": true,
  "description": "Mail, contacts and calendar model with a pluggable store",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./idb": {
      "types": "./dist/idb.d.ts",
      "default": "./dist/idb.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2"
  }
}
