@using Microsoft.Extensions.Options

@model SignUpViewModel
@inject IOptions<SsoOptions> options
@{
    ViewData["Title"] = "sign up";
}

<h1>sign up</h1>

<form class="auth-form" method="post" action="/sso/signup">
    @Html.AntiForgeryToken()
    <input type="hidden" name="PendingId" value="@Model.PendingId" />

    <label for="email">ReLive ID:</label>
    <input id="email"
           asp-for="EmailAddress"
           type="email"
           autocomplete="email"
           class="textbox"
           placeholder="example555@example.com"
           value="@Model.EmailAddress" />

    <label for="username">Username:</label>
    <input id="username"
           asp-for="Username"
           type="text"
           autocomplete="username"
           class="textbox"
           value="@Model.Username" />

    <label for="password">Password:</label>
    <input id="password"
           asp-for="Password"
           type="password"
           autocomplete="new-password"
           class="textbox" />

    <label for="confirm-password">Confirm password:</label>
    <input id="confirm-password"
           asp-for="ConfirmPassword"
           type="password"
           autocomplete="new-password"
           class="textbox" />

        @if(options.Value.InviteCodeRequired)
        {
            <label for="invite-code">Invite code:</label>
            <input id="invite-code"
                   asp-for="InviteCode"
                   type="text"
                   autocomplete="off"
                   autocapitalize="characters"
                   spellcheck="false"
                   class="textbox invite-code"
                   placeholder="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                   value="@Model.InviteCode" />
        }

    <label class="remember-me" for="remember-me">
        <input id="remember-me"
               name="RememberMe"
               type="checkbox"
               class="checkbox"
               value="true"
               @(Model.RememberMe ? "checked" : null) />
        <span class="remember-me-text">Remember me</span>
    </label>

    @if (Model.Error is { Length: > 0 })
    {
        <p class="error">@Model.Error</p>
    }

    <input type="submit" class="submit" value="Sign up" />

    <a href="/sso/signin?pending=@Uri.EscapeDataString(Model.PendingId)" class="alternate-link">sign in</a>
</form>
