@model ReLiveWP.Services.Login.Models.RST2.RST2ServiceModel
<S:Envelope xmlns:S="http://www.w3.org/2003/05/soap-envelope"
            xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
            xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
            xmlns:wsa="http://www.w3.org/2005/08/addressing"
            xmlns:wssc="http://schemas.xmlsoap.org/ws/2005/02/sc">
    <S:Header>
        <wsa:Action wsu:Id="Action" S:mustUnderstand="1">
            http://schemas.xmlsoap.org/ws/2005/02/trust/RSTR/Issue
        </wsa:Action>
        <wsa:To wsu:Id="To" S:mustUnderstand="1">
            http://schemas.xmlsoap.org/ws/2004/08/addressing/role/anonymous
        </wsa:To>
        <wsse:Security S:mustUnderstand="1">
            <wsu:Timestamp wsu:Id="Timestamp">
                <wsu:Created>@Model.TimeZ</wsu:Created>
                <wsu:Expires>@Model.Time5MZ</wsu:Expires>
            </wsu:Timestamp>
            <wssc:DerivedKeyToken Id="SignKey">
                <wsse:SecurityTokenReference>
                    <wsse:Reference URI="#@Model.DaTokenReference"></wsse:Reference>
                </wsse:SecurityTokenReference>
                <wssc:Nonce>@Model.SignNonce</wssc:Nonce>
            </wssc:DerivedKeyToken>
            <wssc:DerivedKeyToken Id="EncKey">
                <wsse:SecurityTokenReference>
                    <wsse:Reference URI="#@Model.DaTokenReference"></wsse:Reference>
                </wsse:SecurityTokenReference>
                <wssc:Nonce>@Model.EncNonce</wssc:Nonce>
            </wssc:DerivedKeyToken>
            <EncryptedData xmlns="http://www.w3.org/2001/04/xmlenc#" Id="EncHeader"
                           Type="http://www.w3.org/2001/04/xmlenc#Element">
                <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#tripledes-cbc"></EncryptionMethod>
                <CipherData>
                    <CipherValue>@Model.HeaderCipherValue</CipherValue>
                </CipherData>
            </EncryptedData>
        </wsse:Security>
    </S:Header>
    <S:Body wsu:Id="Body">
        <EncryptedData xmlns="http://www.w3.org/2001/04/xmlenc#" Id="EncBody"
                       Type="http://www.w3.org/2001/04/xmlenc#Element">
            <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#tripledes-cbc"></EncryptionMethod>
            <CipherData>
                <CipherValue>@Model.BodyCipherValue</CipherValue>
            </CipherData>
        </EncryptedData>
    </S:Body>
</S:Envelope>