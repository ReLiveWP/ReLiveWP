@model KbArticleViewModel
@{
    var a = Model.Article;
    ViewData["Title"] = $"KB{a.Id}: {a.Title}";
    ViewData["Description"] = a.MetaDescription;
    ViewData["OgType"] = "article";
    ViewData["Canonical"] = a.Url;
    ViewData["Modified"] = a.LastReview.ToString("yyyy-MM-dd");
}

<span class="badge article-type">@a.Type.ToString().ToUpperInvariant()</span>
<h1>@a.Title</h1>
<p class="article-meta">
    Article ID: <span class="mono">@a.Id</span>
    &middot; Last Review: @a.LastReview.ToString("dd MMM yyyy")
    &middot; Revision: @a.Revision
</p>

@if (!string.IsNullOrEmpty(a.Summary))
{
    <p class="article-summary">@a.Summary</p>
}

@if (a.AppliesTo.Count > 0)
{
    <div class="panel applies-to">
        <h2 class="panel-title">Applies to</h2>
        <ul>
            @foreach (var product in a.AppliesTo)
            {
                <li>@product</li>
            }
        </ul>
    </div>
}

@Html.Raw(a.Html)

@if (Model.Fwlink is { } linkId)
{
    <p class="shortlink">
        Short link for this article:
        <a class="mono" href="@Model.Options.Fwlink(linkId)">@Model.Options.Fwlink(linkId)</a>
    </p>
}

@if (Model.SeeAlso.Count > 0)
{
    <h2>See also</h2>
    <ul class="rows articles">
        @foreach (var related in Model.SeeAlso)
        {
            <li>
                <span class="id mono">KB@(related.Id)</span>
                <a href="@related.Url">@related.Title</a>
            </li>
        }
    </ul>
}

<dl class="property-list properties">
    <dt>Article ID</dt>
    <dd class="mono">@a.Id</dd>
    <dt>Article type</dt>
    <dd>@a.Type.ToString().ToUpperInvariant()</dd>
    <dt>Last review</dt>
    <dd>@a.LastReview.ToString("dd MMM yyyy")</dd>
    <dt>Revision</dt>
    <dd>@a.Revision</dd>
    @if (a.ErrorCodes.Count > 0)
    {
        <dt>Error codes</dt>
        <dd class="mono">@string.Join(", ", a.ErrorCodes)</dd>
    }
    @if (a.Keywords.Count > 0)
    {
        <dt>Keywords</dt>
        <dd>@string.Join(" ", a.Keywords)</dd>
    }
</dl>
