@model KbErrorNotFoundViewModel
@{
    ViewData["Title"] = $"Error {Model.Code}";
    ViewData["Robots"] = "noindex";
}

<h1>Error <span class="mono">@Model.Code</span></h1>
<p class="article-summary">No article currently covers this error code.</p>

@if (Model.Suggestions.Count > 0)
{
    <h2>You might be looking for</h2>
    <ul class="articles">
        @foreach (var article in Model.Suggestions)
        {
            <li>
                <span class="id mono">KB@(article.Id)</span>
                <a href="@article.Url">@article.Title</a>
            </li>
        }
    </ul>
}
