@inject Microsoft.Extensions.Options.IOptions<SupportOptions> SupportOptionsAccessor
@inject IConfiguration Configuration
@{
    var origin = SupportOptionsAccessor.Value.BaseUrl is { Length: > 0 } configured
        ? configured.TrimEnd('/')
        : $"{Context.Request.Scheme}://{Context.Request.Host}";

    var canonical = origin + (ViewData["Canonical"] as string ?? Context.Request.Path.Value);
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string;

    var portal = (Configuration["PublicUrls:Portal"] ?? "https://relivewp.net").TrimEnd('/');
    var path = Context.Request.Path.Value ?? "/";

    string NavClass(string href, bool exact = false) =>
        (exact ? path == href : path == href || path.StartsWith($"{href}/"))
            ? "active text-accent"
            : "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>@pageTitle - ReLiveWP Support</title>
    @if (!string.IsNullOrEmpty(description))
    {
        <meta name="description" content="@description" />
    }
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    <link rel="canonical" href="@canonical" />

    <meta property="og:site_name" content="ReLiveWP Support" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@pageTitle" />
    @if (!string.IsNullOrEmpty(description))
    {
        <meta property="og:description" content="@description" />
    }
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="en_GB" />
    @if (ViewData["Modified"] is string modified)
    {
        <meta property="article:modified_time" content="@modified" />
    }
    <meta name="twitter:card" content="summary" />

    <link rel="stylesheet" href="~/support.css" asp-append-version="true" />
</head>

<body class="accent-purple">
    <header>
        <div class="brand-container">
            <div class="brand-search">
                <form class="header-search" action="/search" method="get">
                    <input type="search" name="q" value="@ViewData["Query"]" placeholder="search" />
                    <input type="submit" value="Search" />
                </form>
            </div>
            <a class="home-link" href="/">
                <partial name="_BrandLogo" />
                <div class="header-container">
                    @* a div, not the h1 SiteHeader uses: the article title is this page's h1 *@
                    <div class="header-title">ReLive</div>
                    <p class="header-subtitle text-accent">for Windows Phone</p>
                </div>
            </a>
        </div>
        <nav class="header-nav">
            <ul class="header-items leading">
                <li><a class="@NavClass("/", exact: true)" href="/">support</a></li>
                <li><a class="@NavClass("/kb")" href="/kb">all articles</a></li>
            </ul>
            <ul class="header-items trailing">
                <li><a href="@portal/">home</a></li>
            </ul>
        </nav>
        <hr class="header-splitter" />
    </header>

    <main class="prose">
        @RenderBody()
    </main>

    <footer>
        <div class="site-footer">
            <p>
                <a href="/kb">all articles</a> &bull;
                <a href="@portal/">relivewp.net</a>
            </p>
            <p>relive for windows phone &bull; windows phone is a trademark of Microsoft Corp.</p>
        </div>
    </footer>
</body>

</html>
